# =============================================================================
# Apache (OVH, cPanel, hébergements mutualisés…) — site JCIA 2027
# =============================================================================
Options -Indexes

# --- Pages d'erreur du serveur → pages d'erreur de l'application ------------------
ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 408 /errors/408.html
ErrorDocument 429 /errors/429.html
ErrorDocument 500 /errors/500.html
ErrorDocument 502 /errors/502.html
ErrorDocument 503 /errors/503.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Application monopage : toute URL qui n'est pas un fichier existant
  # est servie par index.html (le routeur React affiche la bonne page, ou la 404)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- Cache : fichiers versionnés (assets/) mis en cache 1 an ; HTML jamais -----------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- En-têtes de sécurité (CSP, HSTS…) : insérés automatiquement au build ---------------
# @SECURITY_HEADERS@

# --- Fichiers sensibles jamais servis ------------------------------------------------------
<FilesMatch "^(\.env.*|.*\.map|README\.md)$">
  Require all denied
</FilesMatch>
