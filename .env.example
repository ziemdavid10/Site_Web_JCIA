# ─────────────────────────────────────────────────────────────────────────────
# Serveur de billetterie JCIA — variables d'environnement
# Copier en .env (développement) ; en production, utiliser le gestionnaire de
# secrets de l'hébergeur / GitHub Environments. NE JAMAIS COMMITER .env.
# Vérifier une configuration : npm run check:config
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development            # production en prod (active les contrôles bloquants)
HOST=0.0.0.0
PORT=5000
TRUST_PROXY=1                   # nb de proxys devant le serveur (Caddy/Nginx = 1)
ALLOWED_ORIGIN=http://localhost:5173,https://www.jcia.cm,https://www.jciacm.com
PUBLIC_SITE_URL=https://www.jcia.cm   # liens « voir mes billets » des e-mails (en local : http://localhost:5173)
DB_PATH=./data/database.sqlite  # en prod : volume persistant sauvegardé (ex. /data/jcia.sqlite)
LOG_LEVEL=info

# Secret serveur (≥ 32 caractères aléatoires) : jetons d'accès aux billets,
# QR des billets gratuits. Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# ─── TIKORA (API Partenaire) ────────────────────────────────────────────────
# Le serveur passe TOUJOURS par TIKORA (aucun paiement simulé) : ces variables
# sont obligatoires, en développement comme en production.
PAYMENT_PROVIDER_MODE=live
TIKORA_API_URL=https://tikoraapi.totiokamdem.uk/api/v1/partner
# La clé SEULE (sans « Authorization: Bearer ») — tk_live_… en prod, tk_test_… en recette
TIKORA_API_KEY=
# Identifiant de l'événement JCIA 2027 sur TIKORA (POST /events puis GET /events)
TIKORA_EVENT_ID=
# Tarif JCIA → catégorie TIKORA (ids renvoyés par GET /events/{id})
# Variante promo : {"standard":{"default":"<uuid>","promo":"<uuid>"}}
TIKORA_CATEGORY_MAP={"etudiant":"","standard":"","en-ligne":"","vip":""}
TIKORA_TIMEOUT_MS=15000
TIKORA_PRICE_CHECK=strict       # refuse la vente si le prix TIKORA ≠ grille JCIA
# Webhooks : URL à déclarer chez TIKORA = https://api.jciacm.com/webhooks/tikora
TIKORA_WEBHOOK_SECRET=

# ─── Achats faits sur la page TIKORA de l'événement ─────────────────────────
# Le serveur relit les commandes TIKORA et envoie à chaque acheteur (une fois)
# l'e-mail contenant le lien du formulaire participant.
ATTENDEE_FORM_URL=https://docs.google.com/forms/d/1jpOGg8oab-88-x19JbFD2-s9IMjPXvjN2XXoOQH-7v8/previewResponse
# Fréquence de relecture (ms, 0 = désactivé) et date avant laquelle les achats sont ignorés
TIKORA_WEB_SYNC_INTERVAL_MS=120000
# TIKORA_WEB_SYNC_SINCE=2026-10-08T00:00:00+01:00
TIKORA_WEBHOOK_SIGNATURE_HEADER=x-tikora-signature
TIKORA_WEBHOOK_REQUIRE_SIGNATURE=false   # true dès que TIKORA signe ses webhooks
RECONCILE_INTERVAL_MS=60000              # rattrapage des paiements en attente

# ─── E-mail (reçus) ─────────────────────────────────────────────────────────
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@jciacm.com
SMTP_PASS=
MAIL_FROM="Billetterie JCIA 2027" <contact@jciacm.com>
MAIL_REPLY_TO=contact@jciacm.com
RECEIPT_MIN_INTERVAL_MS=60000

# ─── Anti-abus ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MULTIPLIER=1
FREE_MAX_SEATS_PER_EMAIL=10
