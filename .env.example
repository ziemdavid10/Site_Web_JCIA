# URL PUBLIQUE du serveur de billetterie JCIA (backend/), en HTTPS.
# Il expose GET /tickets, POST /payments, GET /payments/:id, POST /orders/free,
# GET /orders/:id, POST /orders/:id/receipt et GET /attendees.
# La clé TIKORA (tk_live_…) reste sur ce serveur, JAMAIS dans le navigateur :
# aucune variable VITE_ ne doit contenir de secret (elles sont publiques).
# Laisser vide : le paiement est SIMULÉ (mode démonstration, aucun débit).
VITE_PAYMENT_API_URL=http://localhost:5000

# ⚠ Ce fichier n'est qu'un MODÈLE : Vite ne le lit pas.
# Développement sur votre poste (backend lancé par « npm run dev » ou
# « npm run simulation ») : créer le fichier .env.development.local contenant
#   VITE_PAYMENT_API_URL=http://localhost:5000
# Ce fichier n'est lu que par « npm run dev » (jamais par « npm run build ») et
# n'est pas écrasé par « vercel env pull » (qui réécrit .env.local).

# Après toute modification de cette URL pour la production, lancer :
#   VITE_PAYMENT_API_URL=https://api.jciacm.com npm run sync:vercel
# (la CSP de vercel.json doit autoriser l'API, sinon les appels sont bloqués).
